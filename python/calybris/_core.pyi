"""Type stubs for the PyO3 extension module ``calybris._core``.

Hand-maintained to mirror ``bindings/python/src/lib.rs``. The Rust kernel is
the source of truth; these stubs give mypy and IDEs the shapes of the
Rust-backed classes, methods, and constants. Dict-returning methods use
``dict[str, Any]`` because the payload keys are documented in ``docs/CALY_PROOF.md``
and the audit/budget guides rather than fixed here.
"""

from typing import Any, Literal

