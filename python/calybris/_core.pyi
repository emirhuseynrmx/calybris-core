# ──────────────────────────── classes ─────────────────────────────

class KernelModel:
    """One candidate in a policy catalog. All fields are readable and writable."""

    model_id: int
    provider_id: int
    quality_bps: int
    risk_ceiling_bps: int
    enabled: int
    p95_latency_ms: int
    capabilities: int
    region_mask: int
    input_cost_microunits_per_million_tokens: int
    output_cost_microunits_per_million_tokens: int

    def __init__(
        self,
        model_id: int,
        provider_id: int,
        quality_bps: int,
        risk_ceiling_bps: int,
        enabled: int,
        p95_latency_ms: int,
        capabilities: int,
        region_mask: int,
        input_cost_microunits_per_million_tokens: int,
        output_cost_microunits_per_million_tokens: int,
    ) -> None: ...
    def as_dict(self) -> dict[str, Any]: ...
    def __eq__(self, other: object) -> bool: ...
    def __repr__(self) -> str: ...

