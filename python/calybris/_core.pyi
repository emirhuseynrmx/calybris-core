    ) -> None: ...
    def as_dict(self) -> dict[str, Any]: ...
    def __eq__(self, other: object) -> bool: ...
    def __repr__(self) -> str: ...

class KernelDecision:
    """The kernel's output for one request. Returned by ``PolicySnapshot.prescribe``;
    not constructed directly."""

    @property
    def request_sequence(self) -> int: ...
    @property
    def action(self) -> str: ...
    @property
    def action_code(self) -> int: ...
    @property
    def reason(self) -> str: ...
    @property
    def reason_code(self) -> int: ...
    @property
    def selected_model_id(self) -> int: ...
    @property
    def selected_model_index(self) -> int: ...
    @property
    def estimated_cost_microunits(self) -> int: ...
    @property
    def expected_utility_microunits(self) -> int: ...
    @property
    def counterfactual_model_id(self) -> int: ...
    @property
    def counterfactual_utility_microunits(self) -> int: ...
    @property
    def evaluated_models(self) -> int: ...
    @property
    def eligible_models(self) -> int: ...
    @property
    def policy_epoch(self) -> int: ...
    @property
    def catalog_epoch(self) -> int: ...
    def is_executable(self) -> bool: ...
    def is_rejected(self) -> bool: ...
    def is_requested_execution(self) -> bool: ...
    def is_substitution(self) -> bool: ...
    def as_dict(self) -> dict[str, Any]: ...
    def __repr__(self) -> str: ...

class PolicySnapshot:
    """An immutable policy + catalog. Evaluates requests and emits audit proofs."""

    def __init__(
        self,
        policy_epoch: int,
        catalog_epoch: int,
        hard_risk_limit_bps: int,
        minimum_confidence_bps: int,
        risk_penalty_multiplier_bps: int,
        latency_penalty_microunits_per_ms: int,
        models: list[KernelModel],
    ) -> None: ...
    @property
    def policy_epoch(self) -> int: ...
    @property
    def catalog_epoch(self) -> int: ...
    @property
    def hard_risk_limit_bps(self) -> int: ...
    @property
    def minimum_confidence_bps(self) -> int: ...
    @property
    def risk_penalty_multiplier_bps(self) -> int: ...
    @property
    def latency_penalty_microunits_per_ms(self) -> int: ...
    def prescribe(self, input: KernelInput) -> KernelDecision: ...
    def prescribe_with_trace(
        self, input: KernelInput
    ) -> tuple[KernelDecision, dict[str, Any]]: ...
    def prescribe_batch(self, inputs: list[KernelInput]) -> list[KernelDecision]: ...
    def utility_for_model(self, input: KernelInput, model_id: int) -> int | None: ...
    def counterfactual_utility(
        self, input: KernelInput, model_id: int
    ) -> int | None: ...
    def audit_bundle(
        self, input: KernelInput, decision: KernelDecision
    ) -> dict[str, Any]: ...
    def verified_audit_bundle(
        self, input: KernelInput, decision: KernelDecision
    ) -> dict[str, Any]:
        """Fail-closed: raises ``ValueError`` if the decision does not replay."""
        ...
    def verify(
        self, input: KernelInput, decision: KernelDecision
    ) -> dict[str, Any]: ...
    def verify_status(
        self, input: KernelInput, decision: KernelDecision
    ) -> Literal["valid", "mismatch", "digest_mismatch"]: ...
    def proof_envelope(
        self, input: KernelInput, decision: KernelDecision
    ) -> dict[str, Any]: ...
    def models(self) -> list[KernelModel]: ...
    def model_count(self) -> int: ...
    def fingerprint(self) -> str: ...
    def as_dict(self) -> dict[str, Any]: ...
    def __repr__(self) -> str: ...

