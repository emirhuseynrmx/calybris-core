        request_sequence: int,
        requested_model_id: int,
        input_tokens: int,
        output_tokens: int,
        business_value_microunits: int,
        budget_limit_microunits: int,
        risk_bps: int,
        confidence_bps: int,
        minimum_quality_bps: int,
        max_p95_latency_ms: int,
        required_capabilities: int,
